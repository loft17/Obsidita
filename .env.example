# Puerto donde correrá la aplicación (por defecto 3000)
PORT=3000

# Secreto para firmar cookies: 64 caracteres hexadecimales (32 bytes). Tiene prioridad
# sobre data/.secret. Si no se define (o no es válido) se usa data/.secret y, si tampoco
# sirve, se genera automáticamente uno nuevo.
# COOKIE_SECRET=tu-secreto-aqui

# Node environment
NODE_ENV=production

# Interfaz donde escuchar. 127.0.0.1 = solo local (recomendado detrás de un proxy HTTPS).
# Sin definir escucha en todas las interfaces.
# HOST=127.0.0.1

# Pon 1 si la app está detrás de un proxy inverso (nginx, Caddy), para que el límite
# de intentos de login vea la IP real del cliente.
# TRUST_PROXY=1

# Si se define, el vault solo puede estar dentro de esta carpeta (setup y ajustes).
# VAULTS_ROOT=/srv/vaults

# Comprobar en GitHub si hay una versión nueva de Obsidita (aviso al entrar y en
# Preferencias → Acerca de). Pon 0 para que el servidor no se conecte a GitHub.
# UPDATE_CHECK=1

# --- Límites (sin definir, se usa el valor indicado) ---
# Si subes MAX_UPLOAD_MB o MAX_NOTE_MB, sube también client_max_body_size en nginx.

# Tamaño máximo al guardar una nota (MB)
# MAX_NOTE_MB=20
# Tamaño máximo de un adjunto subido (MB)
# MAX_UPLOAD_MB=50
# Carpeta con fuentes propias (.woff2, .woff, .ttf, .otf) para usar en la web.
# Por defecto, web/src/fonts/ en la carpeta de la app
# FONTS_DIR=/ruta/a/fuentes
# Longitud mínima de la contraseña
# MIN_PASSWORD_LENGTH=12

# Búsqueda
# SEARCH_MAX_QUERY_LENGTH=200
# Las notas de más de este tamaño (MB) no se buscan
# SEARCH_MAX_FILE_MB=2
# Total de notas que se indexan en memoria para la búsqueda (MB)
# SEARCH_MAX_SCANNED_MB=200
# Búsquedas por minuto y por IP
# SEARCH_RATE_MAX=120
# SEARCH_MAX_RESULTS=200
# SEARCH_MAX_MATCHES_PER_FILE=5

# Sesiones (días)
# SESSION_MAX_DAYS=30
# SESSION_IDLE_DAYS=7
